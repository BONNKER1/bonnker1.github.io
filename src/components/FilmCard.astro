---
import type { Film } from '../data/films';
import { formatPrice } from '../data/films';
import GlassSwatch from './GlassSwatch.astro';

interface Props {
  film: Film;
  vlt?: number;
}

const { film, vlt = 15 } = Astro.props;
---
<article class="film-card">
  <GlassSwatch vlt={vlt} label={film.name} />
  <div class="film-card__body">
    <div class="film-card__head">
      <h3>{film.name}</h3>
      {film.badge && <span class="chip chip--accent">{film.badge}</span>}
    </div>
    <p class="film-card__desc">{film.description}</p>
    <ul class="film-card__pros">
      {film.pros.map((pro) => <li>{pro}</li>)}
    </ul>
    <p class="film-card__price">
      от <strong>{formatPrice(film.basePrice)}</strong> за 2 стекла
    </p>
  </div>
</article>

<style>
  .film-card {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .film-card__body {
    display: grid;
    gap: var(--space-3);
  }

  .film-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    justify-content: space-between;
  }

  .film-card__desc {
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .film-card__pros {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  .film-card__pros li {
    display: flex;
    gap: var(--space-2);
  }

  .film-card__pros li::before {
    content: '';
    flex: none;
    width: 0.4rem;
    height: 0.4rem;
    margin-top: 0.55em;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .film-card__price {
    margin-top: auto;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .film-card__price strong {
    color: var(--color-accent);
    font-size: var(--step-2);
  }
</style>

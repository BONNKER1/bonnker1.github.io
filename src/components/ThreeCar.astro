---
interface Props {
  /** Текущая степень затемнения: 5 | 15 | 35 | 50. */
  vlt?: number;
}

const { vlt = 15 } = Astro.props;
---

<div class="three-car" data-three-vlt={vlt}>
  <p class="three-car__loading" data-three-loading>
    <span class="three-car__spinner" aria-hidden="true"></span>
    <span>Загружаем 3D-модель…</span>
  </p>
  <p class="three-car__error" hidden>
    Не удалось загрузить 3D-модель. Проверьте, что файл <code>/models/porsche911.glb</code>
    доступен, и попробуйте обновить страницу.
  </p>
  <p class="three-car__hint" aria-hidden="true">Потяните, чтобы повернуть</p>
</div>

<script>
  interface CarApi {
    setTint: (value: number) => void;
    dispose: () => void;
  }

  declare global {
    interface Window {
      __threeCar?: CarApi;
    }
  }

  const container = document.querySelector<HTMLElement>('.three-car');

  if (container) {
    let api: CarApi | null = null;
    let started = false;
    let desiredVlt = Number(container.getAttribute('data-three-vlt') || 15);

    const loadingEl = container.querySelector<HTMLElement>('[data-three-loading]');
    const errorEl = container.querySelector<HTMLElement>('.three-car__error');

    const showError = (): void => {
      if (loadingEl) loadingEl.hidden = true;
      if (errorEl) errorEl.hidden = false;
    };

    /**
     * Запускаем 3D только тогда, когда до него дошли. Модуль с three.js и сама
     * модель (~15 МБ) грузятся отдельным запросом и не блокируют первый экран.
     */
    const start = async (): Promise<void> => {
      if (started) return;
      started = true;
      try {
        const { initCar } = await import('../scripts/three-car');
        api = initCar(container, {
          vlt: desiredVlt,
          onLoaded: () => {
            container.classList.add('is-ready');
            if (loadingEl) loadingEl.hidden = true;
          },
          onError: showError,
        });
        window.__threeCar = api;
      } catch (error) {
        console.error('[ThreeCar] Не удалось загрузить 3D-модуль:', error);
        showError();
      }
    };

    // Степень затемнения может смениться до загрузки модели — запоминаем её
    // в атрибуте и применяем сразу после инициализации сцены.
    const observer = new MutationObserver(() => {
      const raw = container.getAttribute('data-three-vlt');
      desiredVlt = raw === null ? 15 : Number(raw);
      api?.setTint(desiredVlt);
    });
    observer.observe(container, { attributes: true, attributeFilter: ['data-three-vlt'] });

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            io.disconnect();
            void start();
          }
        },
        // Запас в 400px: модель подгружается чуть раньше, чем до неё доскроллили.
        { rootMargin: '400px 0px' },
      );
      io.observe(container);
    } else {
      void start();
    }
  }
</script>

<style>
  .three-car {
    position: relative;
    width: 100%;
    height: clamp(280px, 58vw, 420px);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, #00eaff 25%, var(--color-border));
    background: radial-gradient(120% 120% at 50% 0%, #041018 0%, #02060a 55%, #010305 100%);
    box-shadow: 0 0 0 1px rgb(0 234 255 / 0.08) inset;
  }

  .three-car__hint {
    position: absolute;
    left: 50%;
    bottom: 0.65rem;
    display: none;
    margin: 0;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    background: rgb(2 6 10 / 0.6);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translateX(-50%);
    pointer-events: none;
  }

  @media (max-width: 899px) {
    .three-car.is-ready .three-car__hint {
      display: block;
    }
  }

  .three-car__loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .three-car__loading[hidden] {
    display: none;
  }

  .three-car__spinner {
    width: 1rem;
    height: 1rem;
    border: 2px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    animation: three-car-spin 0.9s linear infinite;
  }

  @keyframes three-car-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .three-car__spinner {
      animation-duration: 3s;
    }
  }

  .three-car__error {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--space-4);
    margin: 0;
    text-align: center;
    color: var(--color-muted);
    font-size: var(--step-0);
    background: rgb(8 9 10 / 0.85);
  }

  .three-car__error[hidden] {
    display: none;
  }
</style>

---
import Button from './Button.astro';
import { brands } from '../data/cars';
---
<form class="picker" action="/catalog/" method="get" data-picker>
  <div class="picker__fields">
    <div class="field">
      <label for="picker-brand">Марка</label>
      <select id="picker-brand" name="brand" required>
        <option value="">Выберите марку</option>
        {brands.map((brand) => <option value={brand.slug}>{brand.name}</option>)}
      </select>
    </div>

    <div class="field">
      <label for="picker-model">Модель</label>
      <select id="picker-model" name="model" required disabled>
        <option value="">Сначала выберите марку</option>
      </select>
    </div>
  </div>

  <Button type="submit" variant="primary">Подобрать</Button>
</form>

<script>
  interface CatalogIndex {
    brands: [string, string, string][];
    models: [number, string, string, string, string][];
  }

  const form = document.querySelector<HTMLFormElement>('[data-picker]');
  const brandSelect = form?.querySelector<HTMLSelectElement>('select[name="brand"]');
  const modelSelect = form?.querySelector<HTMLSelectElement>('select[name="model"]');

  let indexPromise: Promise<Map<string, [string, string, string][]>> | null = null;

  /** Список моделей по маркам грузим один раз и только когда он понадобился. */
  function loadModels(): Promise<Map<string, [string, string, string][]>> {
    if (!indexPromise) {
      indexPromise = fetch(`${import.meta.env.BASE_URL}catalog-index.json`)
        .then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.json() as Promise<CatalogIndex>;
        })
        .then((data) => {
          const groups = new Map<string, [string, string, string][]>();
          data.models.forEach(([brandIndex, slug, name, years]) => {
            const brandSlug = data.brands[brandIndex]?.[0];
            if (!brandSlug) return;
            const list = groups.get(brandSlug) ?? [];
            list.push([slug, name, years]);
            groups.set(brandSlug, list);
          });
          return groups;
        });
    }
    return indexPromise;
  }

  brandSelect?.addEventListener('change', async () => {
    if (!modelSelect) return;

    const brandSlug = brandSelect.value;
    modelSelect.innerHTML = '';

    if (!brandSlug) {
      modelSelect.disabled = true;
      modelSelect.append(new Option('Сначала выберите марку', ''));
      return;
    }

    modelSelect.disabled = true;
    modelSelect.append(new Option('Загрузка…', ''));

    try {
      const groups = await loadModels();
      if (brandSelect.value !== brandSlug) return;

      modelSelect.innerHTML = '';
      modelSelect.append(new Option('Выберите модель', ''));
      (groups.get(brandSlug) ?? []).forEach(([slug, name, years]) => {
        modelSelect.append(new Option(years ? `${name} · ${years}` : name, slug));
      });
      modelSelect.disabled = false;
    } catch {
      modelSelect.innerHTML = '';
      modelSelect.append(new Option('Не удалось загрузить модели', ''));
    }
  });

  form?.addEventListener('submit', (event) => {
    if (brandSelect?.value && modelSelect?.value) {
      event.preventDefault();
      window.location.href = `/catalog/${brandSelect.value}/${modelSelect.value}/`;
    }
  });
</script>

<style>
  .picker {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    box-shadow: var(--shadow-md);
  }

  .picker__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    flex: 1 1 26rem;
  }

  @media (max-width: 560px) {
    .picker {
      padding: var(--space-4);
    }

    .picker__fields {
      grid-template-columns: 1fr;
    }

    .picker :global(.btn) {
      width: 100%;
    }
  }
</style>

---
import Button from './Button.astro';
import { brands } from '../data/cars';
---
<form class="picker" action="/catalog/" method="get" data-picker>
  <div class="picker__fields">
    <div class="field">
      <label for="picker-brand">Марка</label>
      <select id="picker-brand" name="brand" required>
        <option value="">Выберите марку</option>
        {brands.map((brand) => <option value={brand.slug}>{brand.name}</option>)}
      </select>
    </div>

    <div class="field">
      <label for="picker-model">Модель</label>
      <select id="picker-model" name="model" required disabled>
        <option value="">Сначала выберите марку</option>
      </select>
    </div>
  </div>

  <Button type="submit" variant="primary">Подобрать</Button>
</form>

<script>
  import { brands } from '../data/cars';

  const form = document.querySelector<HTMLFormElement>('[data-picker]');
  const brandSelect = form?.querySelector<HTMLSelectElement>('select[name="brand"]');
  const modelSelect = form?.querySelector<HTMLSelectElement>('select[name="model"]');

  brandSelect?.addEventListener('change', () => {
    if (!modelSelect) return;

    const brand = brands.find((item) => item.slug === brandSelect.value);
    modelSelect.innerHTML = '';

    if (!brand) {
      modelSelect.disabled = true;
      modelSelect.append(new Option('Сначала выберите марку', ''));
      return;
    }

    modelSelect.disabled = false;
    modelSelect.append(new Option('Выберите модель', ''));
    brand.models.forEach((model) => {
      const label = model.years ? `${model.name} · ${model.years}` : model.name;
      modelSelect.append(new Option(label, model.slug));
    });
  });

  form?.addEventListener('submit', (event) => {
    if (brandSelect?.value && modelSelect?.value) {
      event.preventDefault();
      window.location.href = `/catalog/${brandSelect.value}/${modelSelect.value}/`;
    }
  });
</script>

<style>
  .picker {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    box-shadow: var(--shadow-md);
  }

  .picker__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    flex: 1 1 26rem;
  }

  @media (max-width: 560px) {
    .picker {
      padding: var(--space-4);
    }

    .picker__fields {
      grid-template-columns: 1fr;
    }

    .picker :global(.btn) {
      width: 100%;
    }
  }
</style>

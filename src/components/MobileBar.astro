---
import { site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<nav class="mobile-bar" aria-label="Быстрая навигация">
  <a
    class="mobile-bar__item"
    href="/catalog/"
    aria-current={isActive('/catalog/') ? 'page' : undefined}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <rect x="3" y="3" width="7" height="7" rx="1.6"></rect>
      <rect x="14" y="3" width="7" height="7" rx="1.6"></rect>
      <rect x="3" y="14" width="7" height="7" rx="1.6"></rect>
      <rect x="14" y="14" width="7" height="7" rx="1.6"></rect>
    </svg>
    <span>Каталог</span>
  </a>

  <a
    class="mobile-bar__item"
    href="/tipy-plenki/"
    aria-current={isActive('/tipy-plenki/') ? 'page' : undefined}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <path d="M12 3 3 7.6l9 4.6 9-4.6L12 3Z"></path>
      <path d="m3 12.2 9 4.6 9-4.6"></path>
      <path d="m3 16.6 9 4.6 9-4.6"></path>
    </svg>
    <span>Типы плёнки</span>
  </a>

  <a
    class="mobile-bar__item mobile-bar__item--cta"
    href={site.telegram}
    target="_blank"
    rel="noopener noreferrer"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
      <path d="M21.6 4.3 18.5 19c-.2 1-.8 1.3-1.7.8l-4.6-3.4-2.2 2.1c-.3.3-.5.5-1 .5l.3-4.7 8.6-7.8c.4-.4-.1-.6-.6-.2L7.7 13.1 3.1 11.7c-1-.3-1-1 .2-1.5L20.2 3.4c.9-.3 1.6.2 1.4.9Z"></path>
    </svg>
    <span>Telegram</span>
  </a>
</nav>

<style>
  .mobile-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 45;
    display: none;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-1);
    padding: 0.4rem 0.5rem calc(0.4rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(16px);
    box-shadow: 0 -10px 30px rgb(0 0 0 / 0.45);
  }

  .mobile-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    min-height: 3rem;
    padding: 0.35rem 0.25rem;
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-align: center;
    transition: color 160ms ease-out, background-color 160ms ease-out;
  }

  .mobile-bar__item svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .mobile-bar__item:active {
    background: var(--color-surface-2);
  }

  .mobile-bar__item[aria-current='page'] {
    color: var(--color-text);
  }

  .mobile-bar__item--cta {
    color: var(--color-accent-ink);
    background: var(--color-accent);
  }

  .mobile-bar__item--cta:active {
    background: color-mix(in srgb, var(--color-accent) 82%, #000);
  }

  @media (max-width: 899px) {
    .mobile-bar {
      display: grid;
    }
  }
</style>

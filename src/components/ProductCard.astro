---
import type { CarBrand, CarModel } from '../data/cars';
import { modelSearchText } from '../data/cars';
import { films, formatPrice } from '../data/films';

interface Props {
  brand: CarBrand;
  model: CarModel;
}

const { brand, model } = Astro.props;
const minPrice = Math.min(...films.map((film) => film.basePrice));
const meta = [model.years, model.body].filter(Boolean);
const searchText = modelSearchText(brand, model);
---
<a
  class="car-card"
  href={`/catalog/${brand.slug}/${model.slug}/`}
  data-brand={brand.slug}
  data-model={model.slug}
  data-search={searchText}
>
  <span class="car-card__top">
    <span class="car-card__brand">{brand.name}</span>
    {model.years && <span class="car-card__years">{model.years}</span>}
  </span>
  <span class="car-card__name">{model.name}</span>
  <span class="car-card__bottom">
    <span class="car-card__body">{meta.length ? meta.join(' · ') : 'лекала в наличии'}</span>
    <span class="car-card__price">от {formatPrice(minPrice)}</span>
  </span>
</a>

<style>
  .car-card {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition:
      border-color 160ms ease-out,
      transform 160ms ease-out;
  }

  .car-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .car-card__top,
  .car-card__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .car-card__brand {
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .car-card__name {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .car-card__price {
    color: var(--color-accent);
    font-weight: 600;
    white-space: nowrap;
  }
</style>

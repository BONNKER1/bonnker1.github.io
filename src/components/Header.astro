---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { site } from '../data/site';

const nav = [
  { href: '/catalog/', label: 'Каталог' },
  { href: '/tipy-plenki/', label: 'Типы плёнки' },
  { href: '/dostavka-i-oplata/', label: 'Доставка' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/kontakty/', label: 'Контакты' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="header" data-header>
  <div class="container header__inner">
    <a class="header__logo" href="/" aria-label="Boonker — на главную">
      <Logo />
    </a>

    <nav class="header__nav" id="primary-nav" aria-label="Основная навигация">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header__actions">
      <Button href={site.telegram} variant="primary" size="sm" external>
        Telegram
      </Button>
      <button
        class="nav-burger"
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label="Открыть меню"
        data-nav-toggle
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  toggle?.addEventListener('click', () => {
    const open = header?.toggleAttribute('data-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
  });

  document.querySelectorAll('#primary-nav a').forEach((link) => {
    link.addEventListener('click', () => {
      header?.removeAttribute('data-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: 4.25rem;
  }

  .header__logo {
    flex: none;
  }

  .header__nav {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2rem);
    margin-inline: auto;
    font-size: var(--step--1);
  }

  .header__nav a {
    color: var(--color-muted);
    transition: color 160ms ease-out;
  }

  .header__nav a:hover,
  .header__nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .header__nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-left: auto;
  }

  .nav-burger {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
  }

  .nav-burger span {
    display: block;
    width: 1.1rem;
    height: 2px;
    margin: 0.28rem auto;
    background: var(--color-text);
    transition: transform 160ms ease-out;
  }

  .header[data-open] .nav-burger span:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  .header[data-open] .nav-burger span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .header__nav {
      display: none;
    }

    .nav-burger {
      display: block;
    }

    .header[data-open] .header__nav {
      position: absolute;
      inset: 100% 0 auto;
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: var(--space-2) var(--space-5) var(--space-5);
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
    }

    .header[data-open] .header__nav a {
      padding-block: var(--space-4);
      border-bottom: 1px solid var(--color-border);
    }
  }

  @media (max-width: 420px) {
    .header__actions :global(.btn) {
      display: none;
    }
  }
</style>

---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { site } from '../data/site';

const nav = [
  { href: '/catalog/', label: 'Каталог' },
  { href: '/tipy-plenki/', label: 'Типы плёнки' },
  { href: '/dostavka-i-oplata/', label: 'Доставка' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/kontakty/', label: 'Контакты' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="header" data-header>
  <div class="container header__inner">
    <a class="header__logo" href="/" aria-label="Boonker — на главную">
      <Logo />
    </a>

    <nav class="header__nav" id="primary-nav" aria-label="Основная навигация">
      <p class="header__nav-title">Меню</p>
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <div class="header__nav-cta">
        <Button href={site.telegram} variant="primary" external block>Написать в Telegram</Button>
        <Button href={site.marketplaces.wildberries} variant="secondary" external block>
          Мы на Wildberries
        </Button>
        <Button href={site.marketplaces.ozon} variant="ghost" external block>Мы на Ozon</Button>
      </div>
    </nav>

    <div class="header__actions">
      <Button href={site.telegram} variant="primary" size="sm" external>
        Telegram
      </Button>
      <button
        class="nav-burger"
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label="Открыть меню"
        data-nav-toggle
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  const setOpen = (open: boolean) => {
    if (!header || !toggle) return;
    header.toggleAttribute('data-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
    // На телефоне меню занимает экран — блокируем прокрутку страницы под ним.
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };

  toggle?.addEventListener('click', () => {
    setOpen(!header?.hasAttribute('data-open'));
  });

  document.querySelectorAll('#primary-nav a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });

  // При переходе на десктопную ширину меню-оверлей больше не нужно.
  window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: var(--header-h);
  }

  .header__logo {
    flex: none;
  }

  .header__nav {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2rem);
    margin-inline: auto;
    font-size: var(--step--1);
  }

  .header__nav a {
    color: var(--color-muted);
    transition: color 160ms ease-out;
  }

  .header__nav a:hover,
  .header__nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .header__nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-left: auto;
  }

  .header__nav-title,
  .header__nav-cta {
    display: none;
  }

  .nav-burger {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .nav-burger span {
    display: block;
    width: 1.15rem;
    height: 2px;
    margin: 0.3rem auto;
    background: var(--color-text);
    transition: transform 160ms ease-out;
  }

  .header[data-open] .nav-burger span:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  .header[data-open] .nav-burger span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .header__nav {
      display: none;
    }

    .nav-burger {
      display: grid;
    }

    .header[data-open] .header__nav {
      position: absolute;
      inset: 100% 0 auto;
      display: flex;
      flex-direction: column;
      gap: 0;
      height: calc(100dvh - var(--header-h));
      padding: var(--space-4) var(--space-5) calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--color-bg);
      border-top: 1px solid var(--color-border);
    }

    .header[data-open] .header__nav-title {
      display: block;
      margin-bottom: var(--space-2);
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .header[data-open] .header__nav a {
      display: flex;
      align-items: center;
      min-height: 3.25rem;
      padding-block: var(--space-3);
      border-bottom: 1px solid var(--color-border);
      color: var(--color-text);
      font-size: var(--step-1);
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .header[data-open] .header__nav a[aria-current='page'] {
      color: var(--color-accent);
      text-decoration: none;
    }

    .header[data-open] .header__nav-cta {
      display: grid;
      gap: var(--space-2);
      margin-top: auto;
      padding-top: var(--space-6);
    }

    .header[data-open] .header__nav-cta a {
      justify-content: center;
      min-height: 3rem;
      border-bottom: 0;
      font-size: var(--step-0);
    }
  }

  @media (max-width: 420px) {
    .header__actions :global(.btn) {
      display: none;
    }
  }
</style>

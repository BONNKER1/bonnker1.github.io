---
// Кнопка «наверх»: показывается после прокрутки первого экрана.
---
<button class="to-top" type="button" data-to-top aria-label="Наверх" hidden>
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 19V5"></path>
    <path d="m5 12 7-7 7 7"></path>
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-to-top]');

  if (button) {
    const setVisible = () => {
      if (window.scrollY > 600) button.removeAttribute('hidden');
      else button.setAttribute('hidden', '');
    };

    setVisible();
    window.addEventListener('scroll', setVisible, { passive: true });

    button.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>

<style>
  .to-top {
    position: fixed;
    right: 1rem;
    bottom: 1.5rem;
    z-index: 44;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    color: var(--color-text);
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow-md);
    cursor: pointer;
    transition: border-color 160ms ease-out, color 160ms ease-out, transform 160ms ease-out;
  }

  .to-top svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .to-top:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  .to-top[hidden] {
    display: none;
  }

  @media (max-width: 899px) {
    .to-top {
      right: 0.85rem;
      bottom: calc(4.35rem + env(safe-area-inset-bottom, 0px));
      width: 3rem;
      height: 3rem;
    }
  }
</style>

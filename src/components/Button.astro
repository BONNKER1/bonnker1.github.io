---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'sm';
  block?: boolean;
  external?: boolean;
  type?: 'button' | 'submit';
}

const {
  href,
  variant = 'primary',
  size = 'md',
  block = false,
  external = false,
  type = 'button',
} = Astro.props;

const classes = [
  'btn',
  `btn--${variant}`,
  size === 'sm' ? 'btn--sm' : '',
  block ? 'btn--block' : '',
]
  .filter(Boolean)
  .join(' ');
---

{
  href ? (
    <a
      class={classes}
      href={href}
      {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    >
      <slot />
    </a>
  ) : (
    <button class={classes} type={type}>
      <slot />
    </button>
  )
}

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import GlassSwatch from '../components/GlassSwatch.astro';
import { films, filmByMeter, formatPrice } from '../data/films';
import { site } from '../data/site';
import { breadcrumbsSchema, faqSchema } from '../lib/schema';

const faq = [
  {
    question: 'Сколько стоит плёнка на отрез?',
    answer: `Любой тип плёнки — ${formatPrice(filmByMeter.price)} за ${filmByMeter.unit}. Цена одинаковая для силиконовой, классической, атермальной и жёсткой Premium.`,
  },
  {
    question: 'Можно ли заказать меньше метра?',
    answer:
      'Да, отрезаем нужную длину. Напишите в Telegram, сколько метров и какой тип плёнки нужен, — подтвердим стоимость и наличие.',
  },
  {
    question: 'Чем отрез отличается от комплекта по лекалам?',
    answer:
      'Комплект уже вырезан по форме стёкол конкретной модели. Отрез — это цельное полотно, которое вы кроите сами. Он подходит для нестандартных стёкол, запаса или самостоятельной подрезки.',
  },
  {
    question: 'Плёнка клеится без клея?',
    answer:
      'Да, это та же съёмная плёнка на статике. Она крепится к чистому стеклу без клеевого слоя и снимается без следов.',
  },
];

const schemas = [
  breadcrumbsSchema([
    { name: 'Главная', url: '/' },
    { name: 'Плёнка на отрез', url: '/plenka-na-otrez/' },
  ]),
  faqSchema(faq),
];

const orderText = `Здравствуйте! Хочу заказать плёнку на отрез: тип — ___, длина — ___ м, светопропускание — ___%.`;
const orderLink = `${site.telegram}?text=${encodeURIComponent(orderText)}`;
---

<BaseLayout
  title="Плёнка на отрез — 1 750 ₽ за погонный метр"
  description={`Съёмная тонировочная плёнка на отрез: ${formatPrice(filmByMeter.price)} за ${filmByMeter.unit} для всех типов. Силиконовая, классическая, атермальная и жёсткая Premium, доставка по России.`}
  schemas={schemas}
>
  <div class="container">
    <Breadcrumbs items={[{ name: 'Главная', href: '/' }, { name: 'Плёнка на отрез' }]} />
  </div>

  <section class="section section--tight">
    <div class="container">
      <div class="split">
        <div class="split__copy">
          <p class="eyebrow">На отрез</p>
          <h1>Плёнка на отрез</h1>
          <p class="lead">
            Цельное полотно без лекал — для нестандартных стёкол, запаса или самостоятельной
            подрезки. Любой тип плёнки по одной цене.
          </p>
          <p class="price">
            <strong>{formatPrice(filmByMeter.price)}</strong>
            <span>за {filmByMeter.unit}</span>
          </p>
          <div class="actions">
            <Button href={orderLink} variant="primary" external>Заказать в Telegram</Button>
            <Button href="/tipy-plenki/" variant="secondary">Сравнить типы плёнки</Button>
          </div>
        </div>

        <div class="split__visual">
          <GlassSwatch vlt={15} label="Плёнка на отрез" />
          <p class="split__note">
            Цена за метр одинаковая для всех типов: силиконовая, классическая, атермальная и
            жёсткая Premium.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Ассортимент</p>
        <h2>Какие плёнки можно взять на отрез</h2>
        <p class="lead">Все варианты съёмные, крепятся на статике и снимаются без следов.</p>
      </div>

      <div class="grid grid--4">
        {
          films.map((film) => (
            <article class="type-card">
              <h3>{film.name}</h3>
              <p>{film.short}</p>
              <span class="type-card__price">{formatPrice(filmByMeter.price)} / м</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Как заказать</p>
        <h2>Три шага</h2>
      </div>

      <ol class="flow">
        <li>
          <span class="flow__num">01</span>
          <div>
            <h3>Выберите тип и длину</h3>
            <p>Определитесь с плёнкой, метражом и процентом светопропускания.</p>
          </div>
        </li>
        <li>
          <span class="flow__num">02</span>
          <div>
            <h3>Напишите в Telegram</h3>
            <p>Подтвердим наличие, посчитаем стоимость и согласуем доставку.</p>
          </div>
        </li>
        <li>
          <span class="flow__num">03</span>
          <div>
            <h3>Получите отрез</h3>
            <p>Отправляем СДЭК или Почтой России, возможен самовывоз в {site.city}.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Вопросы о плёнке на отрез</h2>
      </div>

      <div class="faq">
        {
          faq.map((item) => (
            <details class="faq__item">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>

      <div class="cta-inline">
        <Button href="/catalog/" variant="primary">Подобрать комплект по авто</Button>
        <Button href={site.telegram} variant="secondary" external>Спросить в Telegram</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--space-10);
    align-items: center;
  }

  .split__copy {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .price strong {
    color: var(--color-accent);
    font-size: var(--step-3);
    letter-spacing: -0.03em;
  }

  .price span {
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .split__visual {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .split__note {
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .type-card {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .type-card p {
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .type-card__price {
    margin-top: auto;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .flow {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-6);
    padding: 0;
    list-style: none;
  }

  .flow li {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-strong);
  }

  .flow__num {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .flow p {
    margin-top: var(--space-2);
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .faq {
    display: grid;
    gap: var(--space-3);
    max-width: 52rem;
  }

  .faq__item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .faq__item summary {
    padding: var(--space-4) var(--space-5);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary::after {
    content: '+';
    float: right;
    color: var(--color-accent);
  }

  .faq__item[open] summary::after {
    content: '−';
  }

  .faq__item p {
    padding: 0 var(--space-5) var(--space-5);
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .cta-inline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>

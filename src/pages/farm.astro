---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Boonker Farm Command Center">
    <div style="height: 80vh; display: flex; align-items: center; justify-content: center; background: #050505; color: #00ff41; font-family: 'Courier New', monospace;">
        <div class="dashboard" style="width: 400px; padding: 30px; border: 2px solid #00ff41; border-radius: 5px; box-shadow: 0 0 20px rgba(0, 255, 65, 0.2);">
            <h1 style="font-size: 18px; text-align: center; margin-bottom: 30px; letter-spacing: 2px;">BOONKER • COMMAND CENTER</h1>
            <div id="status" style="text-align: center; margin-bottom: 20px; font-size: 12px; color: #008800;">STATUS: SYSTEM READY</div>
            
            <button class="btn" style="width: 100%; padding: 15px; margin: 10px 0; background: transparent; border: 1px solid #00ff41; color: #00ff41; cursor: pointer; transition: 0.3s; font-family: inherit; font-size: 14px;" onclick="act('WATERING_SYSTEM')">ACTIVATE: WATERING</button>
            <button class="btn" style="width: 100%; padding: 15px; margin: 10px 0; background: transparent; border: 1px solid #00ff41; color: #00ff41; cursor: pointer; transition: 0.3s; font-family: inherit; font-size: 14px;" onclick="act('GROW_LIGHTS')">ACTIVATE: LIGHTS</button>
            <button class="btn" style="width: 100%; padding: 15px; margin: 10px 0; background: transparent; border: 1px solid #00ff41; color: #00ff41; cursor: pointer; transition: 0.3s; font-family: inherit; font-size: 14px;" onclick="act('VENTILATION')">ACTIVATE: VENTILATION</button>
        </div>
    </div>

    <style>
        .btn:hover { background: #00ff41; color: #000; }
        .blink { animation: blinker 1s linear infinite; }
        @keyframes blinker { 50% { opacity: 0; } }
    </style>

    <script is:inline>
        function act(system) {
            const status = document.getElementById('status');
            status.innerText = "EXECUTING: " + system + "...";
            status.classList.add('blink');
            
            setTimeout(() => {
                status.innerText = "STATUS: " + system + " ACTIVE (LIVE)";
                status.classList.remove('blink');
                setTimeout(() => {
                    status.innerText = "STATUS: SYSTEM READY";
                }, 3000);
            }, 1500);
        }
    </script>
</BaseLayout>

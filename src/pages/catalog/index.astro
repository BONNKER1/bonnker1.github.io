---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import { brands, popularModels, totalModels } from '../../data/cars';
import { breadcrumbsSchema, canonicalUrl } from '../../lib/schema';

const brandCards = [...brands].sort((a, b) => {
  if (a.slug === 'lada') return -1;
  if (b.slug === 'lada') return 1;
  return a.name.localeCompare(b.name, 'ru');
});

const modelsWord = (count: number) => {
  const tail10 = count % 10;
  const tail100 = count % 100;
  if (tail10 === 1 && tail100 !== 11) return 'модель';
  if (tail10 >= 2 && tail10 <= 4 && (tail100 < 12 || tail100 > 14)) return 'модели';
  return 'моделей';
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Марки автомобилей в каталоге тонировки по лекалам',
  numberOfItems: brandCards.length,
  itemListElement: brandCards.map((brand, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: `Тонировка ${brand.name} по лекалам`,
    url: canonicalUrl(`/catalog/${brand.slug}/`),
  })),
};

const schemas = [
  breadcrumbsSchema([
    { name: 'Главная', url: '/' },
    { name: 'Каталог', url: '/catalog/' },
  ]),
  itemListSchema,
];
---

<BaseLayout
  title="Каталог тонировки по лекалам"
  description={`Лекала для ${totalModels} моделей автомобилей ${brandCards.length} марок: передние и задние полусферы, полный комплект. Силиконовая, классическая, атермальная и жёсткая Premium плёнка.`}
  schemas={schemas}
>
  <div class="container">
    <Breadcrumbs items={[{ name: 'Главная', href: '/' }, { name: 'Каталог' }]} />
  </div>

  <section class="section section--tight">
    <div class="container">
      <p class="eyebrow">Каталог</p>
      <h1>Тонировка по лекалам — выберите авто</h1>
      <p class="lead">
        {totalModels} моделей {brandCards.length} марок: от ВАЗ и Toyota до BMW, Land Rover и
        китайских новинок. Начните вводить марку или модель — покажем подходящие лекала с годами
        выпуска.
      </p>

      <div class="catalog-search">
        <div class="field catalog-search__field">
          <label for="catalog-search">Марка или модель</label>
          <input
            id="catalog-search"
            type="search"
            data-search
            placeholder="Например: Camry, Солярис, 2109, Land Cruiser"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            inputmode="search"
            enterkeyhint="search"
          />
        </div>
        <div class="catalog-search__suggest" data-suggest-list>
          <span>Часто ищут:</span>
          <button type="button" data-suggest="Camry">Camry</button>
          <button type="button" data-suggest="Солярис">Солярис</button>
          <button type="button" data-suggest="2109">2109</button>
          <button type="button" data-suggest="Land Cruiser">Land Cruiser</button>
          <button type="button" data-lucky>Мне повезёт ✨</button>
        </div>
      </div>

      <div class="search-results" data-results hidden>
        <p class="search-results__meta">
          Найдено <strong data-results-count>0</strong>
          <span data-results-note></span>
        </p>
        <ul class="search-results__list" data-results-list></ul>
        <p class="search-results__empty" data-results-empty hidden>
          Ничего не найдено. <a href="/kontakty/">Напишите нам</a> — проверим лекало по вашей марке
          и году выпуска.
        </p>
      </div>

      <div data-browse>
        <section class="catalog-block">
          <h2>Часто заказывают</h2>
          <div class="grid grid--4">
            {popularModels.map(({ brand, model }) => <ProductCard brand={brand} model={model} />)}
          </div>
        </section>

        <section class="catalog-block">
          <div class="catalog-block__head">
            <h2>Все марки</h2>
            <span class="catalog-block__count">{brandCards.length}</span>
          </div>
          <div class="brands-grid">
            {
              brandCards.map((brand) => (
                <a class="brand-tile" href={`/catalog/${brand.slug}/`}>
                  <span class="brand-tile__name">{brand.name}</span>
                  <span class="brand-tile__count">
                    {brand.models.length} {modelsWord(brand.models.length)}
                  </span>
                </a>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { fold, matchesQuery, tokenize } from '../../lib/search';

  interface IndexData {
    /** [slug, имя, строка для поиска] */
    brands: [string, string, string][];
    /** [индекс марки, slug, имя, годы, алиасы] */
    models: [number, string, string, string, string][];
  }

  interface PreparedModel {
    brandSlug: string;
    brandName: string;
    href: string;
    name: string;
    years: string;
    text: string;
    folded: string;
    tokens: string[];
  }

  const base = import.meta.env.BASE_URL;

  const input = document.querySelector<HTMLInputElement>('[data-search]');
  const browse = document.querySelector<HTMLElement>('[data-browse]');
  const results = document.querySelector<HTMLElement>('[data-results]');
  const resultsList = document.querySelector<HTMLElement>('[data-results-list]');
  const resultsCount = document.querySelector<HTMLElement>('[data-results-count]');
  const resultsNote = document.querySelector<HTMLElement>('[data-results-note]');
  const resultsEmpty = document.querySelector<HTMLElement>('[data-results-empty]');
  const suggestButtons = document.querySelectorAll<HTMLButtonElement>('[data-suggest]');

  const LIMIT = 80;

  let indexPromise: Promise<PreparedModel[]> | null = null;

  function loadIndex(): Promise<PreparedModel[]> {
    if (!indexPromise) {
      indexPromise = fetch(`${base}catalog-index.json`)
        .then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.json() as Promise<IndexData>;
        })
        .then((data) =>
          data.models.map(([brandIndex, slug, name, years, aliases]) => {
            const [brandSlug, brandName, brandSearch] = data.brands[brandIndex] ?? ['', '', ''];
            const text = `${brandName} ${name} ${aliases}`.toLowerCase();
            const searchable = `${brandSearch} ${name} ${aliases}`.toLowerCase();
            return {
              brandSlug,
              brandName,
              href: `${base}catalog/${brandSlug}/${slug}/`,
              name,
              years,
              text,
              folded: fold(searchable),
              tokens: tokenize(searchable),
            };
          }),
        );
    }
    return indexPromise;
  }

  function render(models: PreparedModel[]) {
    if (!resultsList) return;

    const fragment = document.createDocumentFragment();
    models.forEach((model) => {
      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = model.href;
      link.className = 'result';

      const brand = document.createElement('span');
      brand.className = 'result__brand';
      brand.textContent = model.brandName;

      const name = document.createElement('span');
      name.className = 'result__name';
      name.textContent = model.name;

      const years = document.createElement('span');
      years.className = 'result__years';
      years.textContent = model.years || 'годы уточним';

      const arrow = document.createElement('span');
      arrow.className = 'result__arrow';
      arrow.textContent = '→';

      link.append(brand, name, years, arrow);
      item.append(link);
      fragment.append(item);
    });

    resultsList.replaceChildren(fragment);
  }

  let timer: number | undefined;

  async function applySearch() {
    const query = input?.value.trim() ?? '';

    if (!query) {
      if (results) results.hidden = true;
      if (browse) browse.hidden = false;
      return;
    }

    if (results) results.hidden = false;
    if (browse) browse.hidden = true;

    try {
      const models = await loadIndex();
      const matched = models.filter((model) =>
        matchesQuery(query, model.text, model.folded, model.tokens),
      );

      const needle = fold(query);
      matched.sort((a, b) => {
        const score = (model: PreparedModel) => {
          const name = model.folded;
          if (name === needle) return 0;
          if (name.startsWith(needle)) return 1;
          if (name.includes(needle)) return 2;
          return 3;
        };
        return score(a) - score(b) || a.brandName.localeCompare(b.brandName, 'ru') || a.name.localeCompare(b.name, 'ru');
      });

      const visible = matched.slice(0, LIMIT);
      render(visible);

      if (resultsCount) resultsCount.textContent = String(matched.length);
      if (resultsNote) {
        resultsNote.textContent =
          matched.length > LIMIT ? `Показаны первые ${LIMIT} — уточните запрос` : '';
      }
      if (resultsEmpty) resultsEmpty.hidden = matched.length !== 0;
    } catch (error) {
      if (resultsEmpty) {
        resultsEmpty.hidden = false;
        resultsEmpty.textContent = 'Не удалось загрузить поиск. Откройте список марок ниже.';
      }
      if (browse) browse.hidden = false;
      console.error(error);
    }
  }

  input?.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(applySearch, 120);
  });

  suggestButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (!input) return;
      input.value = button.dataset.suggest ?? '';
      input.focus();
      applySearch();
    });
  });

  document.querySelector<HTMLButtonElement>('[data-lucky]')?.addEventListener('click', async () => {
    try {
      const models = await loadIndex();
      if (!models.length) return;
      const pick = models[Math.floor(Math.random() * models.length)];
      window.location.href = pick.href;
    } catch (error) {
      console.error(error);
    }
  });

  const params = new URLSearchParams(window.location.search);
  const paramBrand = params.get('brand');
  const paramModel = params.get('model');
  if (paramBrand) {
    window.location.replace(
      paramModel
        ? `${base}catalog/${paramBrand}/${paramModel}/`
        : `${base}catalog/${paramBrand}/`,
    );
  } else {
    const initial = params.get('q');
    if (initial && input) {
      input.value = initial;
      applySearch();
    }
  }
</script>

<style>
  .catalog-search {
    margin-block: var(--space-8) var(--space-6);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .catalog-search__field {
    max-width: 34rem;
  }

  .catalog-search__suggest {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .catalog-search__suggest button {
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface-2);
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
    transition:
      border-color 140ms ease-out,
      color 140ms ease-out;
  }

  .catalog-search__suggest button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .catalog-search__suggest button[data-lucky] {
    border-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    color: var(--color-accent);
    font-weight: 600;
  }

  .catalog-block {
    margin-top: var(--space-10);
  }

  .catalog-block__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .catalog-block__count {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .brands-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .brand-tile {
    display: grid;
    gap: 0.15rem;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    text-decoration: none;
    transition:
      border-color 150ms ease-out,
      transform 150ms ease-out;
  }

  .brand-tile:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .brand-tile__name {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand-tile__count {
    color: var(--color-muted);
    font-size: 0.76rem;
  }

  .search-results {
    margin-top: var(--space-6);
  }

  .search-results__meta {
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .search-results__meta strong {
    color: var(--color-text);
  }

  .search-results__list {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
    list-style: none;
  }

  .search-results__list :global(.result) {
    display: grid;
    grid-template-columns: minmax(0, 8rem) minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    text-decoration: none;
    transition:
      border-color 140ms ease-out,
      background-color 140ms ease-out;
  }

  .search-results__list :global(.result:hover) {
    border-color: var(--color-accent);
  }

  .search-results__list :global(.result__brand) {
    overflow: hidden;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .search-results__list :global(.result__name) {
    font-weight: 600;
  }

  .search-results__list :global(.result__years) {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    white-space: nowrap;
  }

  .search-results__list :global(.result__arrow) {
    color: var(--color-accent);
  }

  .search-results__empty {
    margin-top: var(--space-6);
    padding: var(--space-6);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-muted);
    text-align: center;
  }

  .search-results__empty a {
    color: var(--color-accent);
  }

  @media (max-width: 760px) {
    .catalog-search {
      position: sticky;
      top: calc(var(--header-h) + 0.25rem);
      z-index: 20;
      margin-block: var(--space-6) var(--space-5);
      padding: var(--space-2) var(--space-3);
      background: color-mix(in srgb, var(--color-surface) 94%, transparent);
      backdrop-filter: blur(14px);
      box-shadow: var(--shadow-md);
    }

    .catalog-search__field label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .catalog-search__suggest {
      display: none;
    }

    .search-results__list :global(.result) {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.15rem var(--space-3);
      padding: var(--space-3);
    }

    .search-results__list :global(.result__brand) {
      grid-column: 1 / -1;
    }

    .search-results__list :global(.result__arrow) {
      display: none;
    }
  }
</style>

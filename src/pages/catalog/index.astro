---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import { brands, totalModels } from '../../data/cars';
import { breadcrumbsSchema, canonicalUrl } from '../../lib/schema';

const allModels = brands.flatMap((brand) => brand.models.map((model) => ({ brand, model })));
const sortedModels = [...allModels].sort((a, b) => {
  const popular = Number(Boolean(b.model.popular)) - Number(Boolean(a.model.popular));
  return popular || a.brand.name.localeCompare(b.brand.name, 'ru');
});

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Каталог тонировки по маркам и моделям',
  numberOfItems: sortedModels.length,
  itemListElement: sortedModels.map(({ brand, model }, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: `${brand.name} ${model.name}`,
    url: canonicalUrl(`/catalog/${brand.slug}/${model.slug}/`),
  })),
};

const schemas = [
  breadcrumbsSchema([
    { name: 'Главная', url: '/' },
    { name: 'Каталог', url: '/catalog/' },
  ]),
  itemListSchema,
];
---
<BaseLayout
  title="Каталог тонировки по лекалам"
  description={`Лекала для ${totalModels} моделей автомобилей: передние и задние полусферы, полный комплект. Силиконовая, классическая, атермальная и жёсткая Premium плёнка.`}
  schemas={schemas}
>
  <div class="container">
    <Breadcrumbs items={[{ name: 'Главная', href: '/' }, { name: 'Каталог' }]} />
  </div>

  <section class="section section--tight">
    <div class="container">
      <p class="eyebrow">Каталог</p>
      <h1>Тонировка по лекалам — выберите авто</h1>
      <p class="lead">
        В базе {totalModels} моделей: от ВАЗ и Toyota до BMW и Land Rover. Найдите свою марку и
        модель — покажем доступные комплекты и цены.
      </p>

      <div class="filters">
        <div class="field">
          <label for="filter-brand">Марка</label>
          <select id="filter-brand" data-brand-filter>
            <option value="">Все марки</option>
            {brands.map((brand) => <option value={brand.slug}>{brand.name}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="filter-search">Поиск</label>
          <input
            id="filter-search"
            type="search"
            data-search
            placeholder="Модель или марка"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            inputmode="search"
            enterkeyhint="search"
          />
        </div>

        <p class="filters__count">
          Показано <strong data-count>{sortedModels.length}</strong> из {sortedModels.length}
        </p>
      </div>

      <div class="grid grid--4 catalog-grid" data-catalog-grid>
        {sortedModels.map(({ brand, model }) => <ProductCard brand={brand} model={model} />)}
      </div>

      <p class="empty" data-empty hidden>
        Ничего не найдено. Попробуйте другую марку или <a href="/kontakty/">напишите нам</a> —
        проверим лекало.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const grid = document.querySelector<HTMLElement>('[data-catalog-grid]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.car-card'));
  const brandFilter = document.querySelector<HTMLSelectElement>('[data-brand-filter]');
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  const params = new URLSearchParams(window.location.search);
  const paramBrand = params.get('brand');
  const paramModel = params.get('model');

  if (paramBrand && brandFilter) brandFilter.value = paramBrand;

  // Кириллица → латиница + фонетическое свёртывание, чтобы «камри» находило Camry,
  // «солярис» — Solaris, «шкода» — Skoda.
  const translitMap: Record<string, string> = {
    а: 'a', б: 'b', в: 'v', г: 'g', д: 'd', е: 'e', ё: 'e', ж: 'zh', з: 'z',
    и: 'i', й: 'y', к: 'k', л: 'l', м: 'm', н: 'n', о: 'o', п: 'p', р: 'r',
    с: 's', т: 't', у: 'u', ф: 'f', х: 'h', ц: 'ts', ч: 'ch', ш: 'sh',
    щ: 'sch', ъ: '', ы: 'y', ь: '', э: 'e', ю: 'yu', я: 'ya',
  };

  const fold = (value: string) =>
    value
      .toLowerCase()
      .replace(/ё/g, 'е')
      .replace(/дж/g, 'j')
      .replace(/[а-я]/g, (char) => translitMap[char] ?? char)
      .replace(/sch|sh/g, 's')
      .replace(/c/g, 'k')
      .replace(/y/g, 'i')
      .replace(/w/g, 'v');

  const tokenize = (value: string) =>
    fold(value)
      .split(/[^a-z0-9]+/)
      .filter((token) => token.length > 0);

  const editDistance = (a: string, b: string): number => {
    const dp = Array.from({ length: b.length + 1 }, (_, index) => index);
    for (let i = 1; i <= a.length; i += 1) {
      let previous = dp[0];
      dp[0] = i;
      for (let j = 1; j <= b.length; j += 1) {
        const current = dp[j];
        dp[j] = Math.min(
          dp[j] + 1,
          dp[j - 1] + 1,
          previous + (a[i - 1] === b[j - 1] ? 0 : 1),
        );
        previous = current;
      }
    }
    return dp[b.length];
  };

  const isClose = (needle: string, token: string): boolean => {
    if (token === needle || token.startsWith(needle)) return true;
    // Цифры (годы, индексы моделей) сравниваем только точно: 2107 ≠ 2109.
    if (/^\d+$/.test(needle)) return false;
    const allowed = needle.length >= 7 ? 2 : needle.length >= 4 ? 1 : 0;
    return allowed > 0 && editDistance(needle, token) <= allowed;
  };

  const searchIndex = cards.map((card) => {
    const text = `${card.textContent ?? ''} ${card.dataset.search ?? ''}`;
    return {
      card,
      text: text.toLowerCase(),
      latin: fold(text),
      tokens: tokenize(text),
    };
  });

  function applyFilter() {
    const rawQuery = (search?.value ?? '').trim().toLowerCase();
    const queryTokens = tokenize(rawQuery);
    const brand = brandFilter?.value ?? '';
    let visible = 0;

    searchIndex.forEach(({ card, text, latin, tokens }) => {
      const matchesBrand = !brand || card.dataset.brand === brand;
      const matchesQuery =
        !rawQuery ||
        text.includes(rawQuery) ||
        (queryTokens.length > 0 && queryTokens.every((needle) => isClose(needle, latin) || tokens.some((token) => isClose(needle, token))));
      const matchesModel = !paramModel || card.dataset.model === paramModel;
      const show = matchesBrand && matchesQuery && matchesModel;
      card.hidden = !show;
      if (show) visible += 1;
    });

    if (count) count.textContent = String(visible);
    if (empty) empty.hidden = visible !== 0;
    grid?.setAttribute('data-filtered', visible === 0 ? 'true' : 'false');
  }

  brandFilter?.addEventListener('change', applyFilter);
  search?.addEventListener('input', applyFilter);
  applyFilter();
</script>

<style>
  .filters {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-4);
    margin-block: var(--space-8) var(--space-6);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .filters__count {
    color: var(--color-muted);
    font-size: var(--step--1);
    white-space: nowrap;
  }

  .filters__count strong {
    color: var(--color-text);
  }

  .catalog-grid {
    margin-top: var(--space-2);
  }

  .car-card[hidden] {
    display: none;
  }

  .empty {
    margin-top: var(--space-8);
    padding: var(--space-6);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-muted);
    text-align: center;
  }

  .empty a {
    color: var(--color-accent);
  }

  @media (max-width: 760px) {
    .filters {
      position: sticky;
      top: calc(var(--header-h) + 0.25rem);
      z-index: 20;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: center;
      gap: var(--space-2);
      margin-block: var(--space-6) var(--space-5);
      padding: var(--space-2);
      background: color-mix(in srgb, var(--color-surface) 94%, transparent);
      backdrop-filter: blur(14px);
      box-shadow: var(--shadow-md);
    }

    /* Подписи нужны скринридерам, но на телефоне место дороже. */
    .filters .field label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .filters select,
    .filters input[type='search'] {
      padding-inline: 0.65rem;
      font-size: var(--step--1);
    }

    .filters__count {
      grid-column: 1 / -1;
      font-size: 0.72rem;
      text-align: center;
    }

    .catalog-grid {
      gap: var(--space-3);
    }
  }
</style>

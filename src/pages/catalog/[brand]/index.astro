---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { brands, type CarBrand } from '../../../data/cars';
import { chunkModels, renderModelLink, renderModelRow } from '../../../lib/brand-models';
import { breadcrumbsSchema } from '../../../lib/schema';

export function getStaticPaths() {
  return brands.map((brand) => ({
    params: { brand: brand.slug },
    props: { brand },
  }));
}

interface Props {
  brand: CarBrand;
}

const { brand } = Astro.props as Props;
const brandLabel = brand.name.replace(/\s*\([^)]*\)/, '');

const chunks = chunkModels(brand.models);
const firstPage = chunks[0] ?? [];
const hasMore = chunks.length > 1;
const rowsHtml = firstPage.map((model) => renderModelRow(brand, model)).join('');
const linksHtml = brand.models.map((model) => renderModelLink(brand, model)).join('');

const schemas = [
  breadcrumbsSchema([
    { name: 'Главная', url: '/' },
    { name: 'Каталог', url: '/catalog/' },
    { name: brandLabel, url: `/catalog/${brand.slug}/` },
  ]),
];
---

<BaseLayout
  title={`Тонировка ${brandLabel} по лекалам`}
  description={`Съёмная тонировка для ${brandLabel}: ${brand.models.length} моделей в базе лекал с годами выпуска. Передние и задние полусферы, полный комплект, силиконовая, классическая, атермальная и жёсткая Premium плёнка.`}
  schemas={schemas}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { name: 'Главная', href: '/' },
        { name: 'Каталог', href: '/catalog/' },
        { name: brandLabel },
      ]}
    />
  </div>

  <section class="section section--tight">
    <div class="container">
      <p class="eyebrow">Марка</p>
      <h1>Тонировка {brandLabel} по лекалам</h1>
      <p class="lead">
        {brand.models.length} моделей в базе. Годы выпуска — в отдельном столбце, рядом прямые
        ссылки на Wildberries и Ozon: где есть точная карточка — ведём на неё, где нет — на поиск
        по магазину.
      </p>

      <div class="brand-tools">
        <div class="field brand-tools__field">
          <label for="brand-search">Поиск по модели</label>
          <input
            id="brand-search"
            type="search"
            data-search
            placeholder={`Например: ${brand.models[0]?.name ?? 'Camry'}`}
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            inputmode="search"
            enterkeyhint="search"
          />
        </div>
        <div class="field brand-tools__field brand-tools__field--narrow">
          <label for="brand-year">Год выпуска</label>
          <select id="brand-year" data-year>
            <option value="">Все годы</option>
            {
              [...new Set(brand.models.map((m) => m.years).filter(Boolean))]
                .sort()
                .map((y) => <option value={y}>{y}</option>)
            }
          </select>
        </div>
        <p class="brand-tools__count">
          Показано <strong data-count>{firstPage.length}</strong> из {brand.models.length}
        </p>
      </div>

      <div class="models-wrap">
        <table class="models">
          <thead>
            <tr>
              <th scope="col">Модель</th>
              <th scope="col" class="models__years">Годы выпуска</th>
              <th scope="col" class="models__buy-head">Купить</th>
            </tr>
          </thead>
          <tbody data-rows set:html={rowsHtml}></tbody>
        </table>
      </div>

      <div class="brand-more">
        <button
          type="button"
          class="btn btn--secondary"
          data-more
          data-json={`/catalog/${brand.slug}/models.json`}
          hidden={!hasMore}
        >
          Показать ещё
        </button>
        <p class="brand-more__note" data-more-note hidden>
          Подгружаем остальные модели…
        </p>
      </div>

      <p class="empty" data-empty hidden>
        Такой модели нет в списке. <a href="/kontakty/">Напишите нам</a> — проверим лекало по вашей
        марке и году выпуска.
      </p>

      <details class="brand-all">
        <summary>Все модели {brandLabel} — быстрые ссылки ({brand.models.length})</summary>
        <ul class="brand-all__list" set:html={linksHtml}></ul>
      </details>

      <p class="brand-note">
        Нет вашей модели? В базе есть лекала почти всех марок — <a href="/catalog/">вернитесь в каталог</a>
        и поищите по названию, или <a href="/kontakty/">спросите в Telegram</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { matchesQuery, fold, tokenize } from '../../../lib/search';

  const tbody = document.querySelector<HTMLElement>('[data-rows]');
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const yearSelect = document.querySelector<HTMLSelectElement>('[data-year]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const moreBtn = document.querySelector<HTMLButtonElement>('[data-more]');
  const moreNote = document.querySelector<HTMLElement>('[data-more-note]');

  interface RowEntry {
    row: HTMLElement;
    text: string;
    folded: string;
    tokens: string[];
    years: string;
  }

  interface ChunkPayload {
    more?: string[][];
  }

  let index: RowEntry[] = [];
  let payload: ChunkPayload | null = null;
  let nextChunk = 0;
  let busy = false;

  function indexRows(): void {
    index = Array.from(document.querySelectorAll<HTMLElement>('[data-row]')).map((row) => {
      const text = (row.dataset.search ?? row.textContent ?? '').toLowerCase();
      const years = row.querySelector('.models__years')?.textContent?.trim() ?? '';
      return { row, text, folded: fold(text), tokens: tokenize(text), years };
    });
  }

  function applyFilter(): void {
    const query = search?.value ?? '';
    const year = yearSelect?.value ?? '';
    let visible = 0;

    index.forEach(({ row, text, folded, tokens, years }) => {
      const show = matchesQuery(query, text, folded, tokens) && (!year || years === year);
      row.hidden = !show;
      if (show) visible += 1;
    });

    if (count) count.textContent = String(visible);
    if (empty) empty.hidden = visible !== 0;
  }

  async function loadPayload(): Promise<ChunkPayload> {
    if (!payload) {
      const url = moreBtn?.dataset.json ?? '';
      const data: ChunkPayload = await fetch(url)
        .then((response) => (response.ok ? response.json() : { more: [] }))
        .catch(() => ({ more: [] }));
      payload = data;
    }
    return payload ?? { more: [] };
  }

  function appendChunk(rows: string[]): void {
    tbody?.insertAdjacentHTML('beforeend', rows.join(''));
    indexRows();
  }

  /** Догружает все оставшиеся страницы — нужно, когда включён фильтр. */
  async function loadAll(): Promise<void> {
    const data = await loadPayload();
    const chunks = data.more ?? [];
    while (nextChunk < chunks.length) {
      appendChunk(chunks[nextChunk]);
      nextChunk += 1;
    }
    if (moreBtn) moreBtn.hidden = true;
  }

  async function showMore(): Promise<void> {
    if (!moreBtn || busy) return;
    busy = true;
    moreBtn.disabled = true;
    if (moreNote) moreNote.hidden = false;

    const data = await loadPayload();
    const chunks = data.more ?? [];
    const chunk = chunks[nextChunk];

    if (chunk) {
      appendChunk(chunk);
      nextChunk += 1;
      applyFilter();
    }

    if (moreNote) moreNote.hidden = true;
    moreBtn.disabled = false;
    if (nextChunk >= chunks.length) {
      moreBtn.hidden = true;
    } else {
      moreBtn.textContent = 'Показать ещё';
    }
    busy = false;
  }

  let filterTimer = 0;
  function onFilterChange(): void {
    window.clearTimeout(filterTimer);
    filterTimer = window.setTimeout(async () => {
      const active = (search?.value ?? '').trim() !== '' || (yearSelect?.value ?? '') !== '';
      // С активным фильтом подгружаем всё — иначе поиск не увидит моделей ниже.
      if (active && nextChunk < (payload?.more?.length ?? Number.POSITIVE_INFINITY)) {
        await loadAll();
      }
      applyFilter();
    }, 200);
  }

  moreBtn?.addEventListener('click', () => {
    void showMore();
  });
  search?.addEventListener('input', onFilterChange);
  yearSelect?.addEventListener('change', onFilterChange);

  indexRows();
  applyFilter();
</script>

<style>
  .brand-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-block: var(--space-8) var(--space-5);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .brand-tools__field {
    flex: 1 1 16rem;
  }

  .brand-tools__field--narrow {
    flex: 0 1 12rem;
  }

  .brand-tools__field select {
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface-2);
    color: var(--color-text);
    font: inherit;
  }

  .brand-tools__count {
    color: var(--color-muted);
    font-size: var(--step--1);
    white-space: nowrap;
  }

  .brand-tools__count strong {
    color: var(--color-text);
  }

  .models-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .models {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  .models th {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-strong);
    background: var(--color-surface-2);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-align: left;
    text-transform: uppercase;
  }

  .models td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }

  .models tr:last-child td {
    border-bottom: 0;
  }

  .models tbody tr:hover {
    background: color-mix(in srgb, var(--color-accent) 5%, transparent);
  }

  .models__name a {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .models__name a:hover {
    color: var(--color-accent);
  }

  .models__body {
    display: block;
    margin-top: 0.1rem;
    color: var(--color-muted);
    font-size: 0.74rem;
    font-weight: 400;
  }

  .models__years {
    width: 11rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .models__buy-head {
    width: 8.5rem;
    text-align: right;
  }

  .models__buy {
    text-align: right;
    white-space: nowrap;
  }

  .mkt {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.4rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition:
      border-color 140ms ease-out,
      color 140ms ease-out;
  }

  .mkt + .mkt {
    margin-left: 0.25rem;
  }

  .mkt:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .mkt--oz {
    color: var(--color-muted);
  }

  .brand-more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .brand-more__note {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .empty {
    margin-top: var(--space-6);
    padding: var(--space-6);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-muted);
    text-align: center;
  }

  .empty a,
  .brand-note a,
  .brand-all :global(a) {
    color: var(--color-accent);
  }

  .brand-all {
    margin-top: var(--space-6);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .brand-all summary {
    cursor: pointer;
    color: var(--color-text);
    font-weight: 600;
  }

  .brand-all__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Ссылки подставлены через set:html — у них нет scope-атрибута Astro. */
  .brand-all__list :global(li) {
    list-style: none;
  }

  .brand-all__list :global(a) {
    text-decoration: none;
  }

  .brand-all__list :global(a:hover) {
    text-decoration: underline;
  }

  .brand-note {
    margin-top: var(--space-5);
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .models tr[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .models th,
    .models td {
      padding: var(--space-2) var(--space-3);
    }

    .models__years {
      width: 6.5rem;
      font-size: 0.72rem;
    }

    .models__buy-head {
      width: 6.5rem;
    }

    .models__name a {
      font-size: var(--step--1);
    }
  }
</style>
